        "on-demand"
      ],
      "usableFromDays": 0,
      "onDemandMax": 4,
      "entitlement": {
        "strategy": "pl-seniority",
        "params": {
          "under": 20,
          "over": 26,
          "thresholdYears": 10,
          "educationYears": {
            "none": 0,
            "basic-vocational": 3,
            "secondary-vocational": 5,
            "general-secondary": 4,
            "post-secondary": 6,
            "higher": 8
          }
        },
        "rule": {
          "ruleId": "pl-entitlement",
          "citation": "Kodeks pracy art. 154 §1 (20 days < 10 years, 26 days ≥ 10 years) and art. 155 §1 (education periods count toward seniority; only the highest qualification counts)",
          "verification": "public-unverified",
          "url": "https://isap.sejm.gov.pl/isap.nsf/DocDetails.xsp?id=WDU19740240141",
          "note": "Overlap between study and work periods is not de-duplicated (art. 155 §2) — verify with payroll."
        }
      },
      "accrual": {
        "strategy": "pl-proportional",
        "params": {
          "topUpOnThreshold": true
        },
        "rule": {
          "ruleId": "pl-accrual",
          "citation": "Kodeks pracy art. 153 §1 (first job: 1/12 after each month), art. 155¹ (proportional in year of joining/leaving), art. 155² (round up to a full day)",
          "verification": "public-unverified",
          "url": "https://isap.sejm.gov.pl/isap.nsf/DocDetails.xsp?id=WDU19740240141"
        }
      },
      "carryOver": {
        "max": null,
        "expiresMonthDay": "09-30",
        "conditionalOnNotice": false,
        "rule": {
          "ruleId": "pl-carry",
          "citation": "Kodeks pracy art. 168: untaken leave must be granted by 30 September of the following year",
          "verification": "public-unverified",
          "url": "https://isap.sejm.gov.pl/isap.nsf/DocDetails.xsp?id=WDU19740240141",
          "note": "Strictly, art. 168 obliges the employer to grant it; the right itself lapses only by 3-year limitation. Modelled as a hard deadline that HR must act on — verify."
        }
      },
      "sickDuringLeave": {
        "mode": "restore",
        "rule": {
          "ruleId": "pl-sick",
          "citation": "Kodeks pracy art. 165–166: leave is postponed/interrupted by temporary incapacity",
          "verification": "public-unverified",
          "url": "https://isap.sejm.gov.pl/isap.nsf/DocDetails.xsp?id=WDU19740240141"
        }
